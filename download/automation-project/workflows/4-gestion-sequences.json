      "parameters": {
        "jsCode": "// Check if the prospect has replied\nconst data = $input.first().json;\n\n// Simulated check - in production this would parse Playwright output\nconst hasReplied = false;\nconst lastReply = hasReplied ? 'Prospect responded positively' : null;\n\nreturn [{\n  json: {\n    ...data,\n    has_replied: hasReplied,\n    last_reply: lastReply,\n    reply_checked_at: new Date().toISOString(),\n    action_result: hasReplied ? 'replied' : 'no_reply'\n  }\n}];"
