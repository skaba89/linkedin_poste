        "query": "SELECT id, first_name, last_name, headline, profile_url, sequence_step, last_contacted_at, next_action_at, status FROM prospects WHERE status = 'contacted' AND next_action_at <= NOW() AND sequence_step < 5 ORDER BY next_action_at ASC LIMIT 30",
        "options": {}
      },
      "id": "postgres-get-followups",
      "name": "Postgres - Get Follow-ups",
