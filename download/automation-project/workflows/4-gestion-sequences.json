      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [660, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "// Calculate the next step in the sequence based on current step\nconst prospect = $input.first().json;\nconst currentStep = prospect.sequence_step || 1;\n\nconst sequenceConfig = {\n  1: {\n    action: 'send_dm',\n    next_action: 'check_reply',\n    delay_days: 3,\n    step_name: 'Premier DM de suivi',\n    context: 'Rappel suite à la connexion. Suggérer un échange.'\n  },\n  2: {\n    action: 'check_reply',\n    next_action: 'send_dm',\n    delay_days: 5,\n    step_name: 'Vérification réponse 1',\n    context: 'Vérifier si le prospect a répondu au premier DM.'\n  },\n  3: {\n    action: 'send_dm',\n    next_action: 'check_reply',\n    delay_days: 4,\n    step_name: 'Deuxième DM - Proposition de valeur',\n    context: 'Partager une ressource utile (article, guide, stats) pertinente pour le prospect.'\n  },\n  4: {\n    action: 'check_reply',\n    next_action: 'send_dm',\n    delay_days: 7,\n    step_name: 'Vérification réponse 2',\n    context: 'Vérifier si le prospect a répondu après la proposition de valeur.'\n  },\n  5: {\n    action: 'send_dm',\n    next_action: 'close',\n    delay_days: 0,\n    step_name: 'Dernier DM - CTA final',\n    context: 'Message final avec CTA clair (call, meeting, ou pause).'  \n  }\n};\n\nconst step = sequenceConfig[currentStep];\nconst nextStep = currentStep + 1;\n\nconst nextActionDate = new Date();\nnextActionDate.setDate(nextActionDate.getDate() + step.delay_days);\n\nreturn [{\n  json: {\n    ...prospect,\n    current_action: step.action,\n    next_action_after: step.next_action,\n    step_name: step.step_name,\n    context: step.context,\n    next_sequence_step: nextStep,\n    next_action_at: nextActionDate.toISOString(),\n    is_final_step: nextStep > 5\n  }\n}];"
      },
      "id": "code-calculate-step",
      "name": "Code - Calculate Next Step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.current_action }}",
        "rules": {
          "rules": [
            { "value2": "send_dm", "outputKey": "sendDm" },
            { "value2": "check_reply", "outputKey": "checkReply" }
          ]
        },
        "fallbackOutput": 0,
        "options": {}
      },
      "id": "switch-action-type",
      "name": "Switch - Action Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1100, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"system\": \"Tu es un expert en prospection LinkedIn B2B. Génère un message de suivi DM personnalisé et naturel en français. Le message doit être court (max 500 chars), chaleureux, et adapté au contexte de la séquence. Ne sois pas intrusif. Ne mentionne pas l'IA.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Génère un DM de suivi LinkedIn pour {{ $json.first_name }} {{ $json.last_name }} (profil: {{ $json.headline }}).\\n\\nContexte: C'est l'étape {{ $json.sequence_step }} de la séquence ({{ $json.step_name }}).\\nInstructions: {{ $json.context }}\\n\\nLe DM doit être naturel et ne pas ressembler à un message automatique.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "claude-generate-dm",
      "name": "Claude - Generate Follow-up DM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 140],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-anthropic-header",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "amount": "={{ Math.floor(Math.random() * (90 - 30 + 1)) + 30 }}",
        "unit": "seconds"
      },
      "id": "wait-before-send",
      "name": "Wait - Random Delay",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1560, 140],
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "// Send the DM via Playwright (simplified)\nconst data = $input.first().json;\nconst claudeData = $('Claude - Generate Follow-up DM').first().json;\nconst dmText = claudeData.content ? claudeData.content[0].text : '';\n\nreturn [{\n  json: {\n    ...data,\n    dm_sent: dmText,\n    dm_sent_at: new Date().toISOString(),\n    action_result: 'dm_sent'\n  }\n}];"
      },
      "id": "playwright-send-dm",
